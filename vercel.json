{
  "services": {
    "frontend": {
      "root": "frontend/",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "src/server.ts",
      "functions": {
        "src/server.ts": {
          "includeFiles": "node_modules/highs/build/**"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
